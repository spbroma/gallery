{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exclusions.schema.json",
  "title": "Gallery exclusions",
  "type": "object",
  "required": ["exclude"],
  "properties": {
    "exclude": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["folder"],
        "properties": {
          "folder": { "type": "string", "minLength": 1 },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
