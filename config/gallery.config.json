{
  "archiveRoot": "~/Pictures/PhotoArchive",
  "outputRoot": "public/gallery",
  "dataFile": "public/data/gallery.json",
  "filtersFile": "public/data/photo-filters.json",
  "neighbors": { "file": "public/data/photo-neighbors.json", "count": 10, "python": ".venv-analysis/bin/python" },
  "publicBaseUrl": "/gallery",
  "processing": { "webMaxEdge": 2200, "thumbMaxEdge": 900, "webQuality": 84, "thumbQuality": 78, "formats": [".jpg", ".jpeg", ".png", ".tif", ".tiff"] },
  "publishing": { "blackFolderSuffix": "_black", "exclusionsFile": "config/gallery.exclusions.json", "albumAllowlist": [], "maxPhotosPerAlbum": null },
  "storage": { "provider": "local", "googleDrive": { "enabled": false, "publicFolderId": "", "credentialsEnv": "GOOGLE_DRIVE_CREDENTIALS_JSON" } }
}
